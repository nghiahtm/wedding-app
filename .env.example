# ===== API =====
PORT=4000
# Chuỗi kết nối MongoDB khi chạy API trực tiếp (npm run dev). Bắt buộc khi NODE_ENV=production.
#   Local:         mongodb://127.0.0.1:27017/wedding_invitation
#   MongoDB Atlas: mongodb+srv://<user>:<mật-khẩu>@<cluster>.mongodb.net/wedding_invitation?retryWrites=true&w=majority
#   Có mật khẩu:   mongodb://<user>:<mật-khẩu>@<host>:27017/wedding_invitation?authSource=admin
# Ký tự đặc biệt trong mật khẩu (@ : / ? #) phải mã hóa URL, ví dụ @ thành %40.
MONGODB_URI=mongodb://127.0.0.1:27017/wedding_invitation
# Origin được phép gọi API trực tiếp, phân tách bằng dấu phẩy. Trên production điền URL công khai của thiệp và admin.
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Khóa quản trị cho thao tác tải/xóa ảnh, nhạc và xem thống kê. Để trống khi dev; BẮT BUỘC khi deploy.
# Admin chạy local dùng cùng khóa này để quản lý dữ liệu production.
# Tạo khóa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# ===== Admin (chỉ chạy local: npm run dev:admin) =====
# API mà admin local quản lý. Dev: http://localhost:4000. Quản lý production: URL HTTPS của thiệp, ví dụ https://thiep.example.com
ADMIN_API_TARGET=http://localhost:4000

# ===== Docker Compose (production) =====
# Tài khoản root cho container MongoDB. Đặt cả hai để bật xác thực (chỉ áp dụng khi volume dữ liệu còn trống).
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# Chuỗi kết nối API dùng trong Docker. Khi đã đặt tài khoản ở trên:
#   mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@mongodb:27017/wedding_invitation?authSource=admin
# Dùng MongoDB bên ngoài (Atlas...) thì điền chuỗi kết nối đó vào đây.
DOCKER_MONGODB_URI=mongodb://mongodb:27017/wedding_invitation
MONGODB_PORT=27017
INVITATION_PORT=8080
# URL công khai của thiệp, để nút "Xem thiệp" ở admin local trỏ đúng.
INVITATION_PUBLIC_URL=http://localhost:8080
